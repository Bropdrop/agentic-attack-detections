// Coding-agent CLIs calling model APIs from servers, and the dispatcher's start-up health check
// Agentic attack detections by ThreatDefence (cross-framework behavior, first written for Cairn). Source: https://github.com/ThreatDefence/agentic-attack-detections
// Example hunt for Microsoft Sentinel. Needs an outbound proxy that records the host and user agent. Test before alerting.
// From the Cairn source code and the CLI packages it pins. Each worker is a coding-agent CLI calling the operator's
// model endpoint: Claude Code 2.1.98 (user agent claude-cli/2.1.98 (external, ...)), Codex 0.118.0 (codex_exec/0.118.0)
// or Pi 0.73.0 (pi/0.73.0). The example configuration points Claude Code at DeepSeek's Anthropic-compatible endpoint
// and Codex and Pi at Alibaba DashScope; NorForge saw DeepSeek models behind the panels, AIA0002 through OpenRouter, and
// Gambit's operator used OpenRouter. At start-up the dispatcher also posts a tiny "ping" request (max_tokens 10) to
// each endpoint with python-requests (dispatcher/workers/health.py:17-36).
// These CLIs are normal on developer laptops. On a server, a container host or a build agent, especially pointed at a
// third-party model gateway, they are worth asking about. Exclude your developer subnets and approved AI gateways.

let Window = 14d;
let AgentUA = dynamic(["claude-cli/", "codex_exec/", "codex_cli_rs/", "pi/0."]);
let ModelHosts = dynamic(["api.deepseek.com", "dashscope.aliyuncs.com", "dashscope-intl.aliyuncs.com", "openrouter.ai",
    "api.anthropic.com", "api.openai.com", "open.bigmodel.cn", "api.moonshot.cn", "api.x.ai"]);
CommonSecurityLog
| where TimeGenerated > ago(Window)
| where DestinationHostName has_any (ModelHosts) or RequestURL has_any (ModelHosts)
| extend UA = RequestClientApplication
| extend Client = case(UA startswith "claude-cli/", "Claude Code", UA startswith "codex_", "Codex", UA startswith "pi/", "Pi",
    UA startswith "python-requests/", "python-requests (Cairn health check if it precedes agent traffic)", "other")
| where Client != "other"
| summarize Requests=count(), Clients=make_set(Client), UAs=make_set(UA, 5), Hosts=make_set(DestinationHostName, 5),
    URLs=make_set(RequestURL, 5), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by SourceIP, SourceUserName
// A source using two or more agent CLIs, or a health-check client next to one, looks like a dispatcher host
| extend Strength = iff(array_length(Clients) >= 2, "several agent CLIs from one source", "one agent CLI")
| order by array_length(Clients) desc, Requests desc
