# Agentic attack detections by ThreatDefence: behaviors shared by agentic attack frameworks
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. Rules keep the SIDs they were first published with.

alert http any any -> $HTTP_SERVERS any (msg:"TD Claude Code WebFetch user agent (Cairn worker page reader, also legitimate Claude Code)"; flow:established,to_server; http.user_agent; content:"Claude-User (claude-code/"; fast_pattern; classtype:misc-activity; sid:9727010; rev:1; metadata:created_at 2026_11_21, confidence Low, malware_family Cairn;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Kali ffuf v2.1.0-dev user agent"; flow:established,to_server; http.user_agent; content:"Fuzz Faster U Fool v2.1.0-dev"; fast_pattern; classtype:web-application-attack; sid:9727011; rev:1; metadata:created_at 2026_11_21, confidence Low;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"TD WSUS admin or sync web service requested from external address"; flow:established,to_server; http.uri; pcre:"/\/(ApiRemoting30\/WebService|ServerSyncWebService\/ServerSyncWebService|ReportingWebService\/ReportingWebService)\.asmx/i"; classtype:attempted-admin; sid:9727040; rev:1; metadata:created_at 2026_11_21, confidence Medium;)
