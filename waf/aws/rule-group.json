          "RegexString": "fuzz faster u fool v2\\.1\\.0-dev|mozilla/5\\.0 \\(compatible exploit\\)|reconprobe/1\\.0|norma/0\\.4|azure-toolkit/1\\.0",
          "FieldToMatch": {
            "SingleHeader": {
