resource "aws_wafv2_rule_group" "td_agentic_attack" {
  name        = "td-agentic-attack"
  scope       = var.scope
  capacity    = 350
  description = "Agentic attack detections by ThreatDefence: framework fingerprints and reported addresses"

  rule {
    name     = "td-framework-user-agents"
    priority = 0

    action {
      dynamic "count" {
        for_each = var.block_tier_action == "count" ? [1] : []
        content {}
      }
      dynamic "block" {
        for_each = var.block_tier_action == "block" ? [1] : []
        content {}
      }
    }

    statement {
      or_statement {
        statement {
          regex_match_statement {
            regex_string = "artex-readonly/|artex-pentest/|artex-audit/|artex-verify/|artex-spawn/|artex-enrich/|artex-worker/|artex-i21861-canary|artex-authorized-pentest|mozilla/5\\.0 artex|mozilla/5\\.0 \\(artex\\)|scopeweaver"
            field_to_match {
              single_header {
                name = "user-agent"
              }
            }
            text_transformation {
              priority = 0
              type     = "LOWERCASE"
            }
          }
        }
        statement {
          regex_match_statement {
            regex_string = "spa-api-recon|antifox-enrich/|hexstrike-http-framework/|hexstrike-browseragent/|cyberstrikeai-webshell/"
            field_to_match {
              single_header {
                name = "user-agent"
              }
            }
            text_transformation {
              priority = 0
              type     = "LOWERCASE"
            }
          }
        }
        statement {
          regex_match_statement {
            regex_string = "ArtExVerify/1\\.0|ArtEx/1\\.0"
            field_to_match {
              single_header {
                name = "user-agent"
              }
            }
            text_transformation {
              priority = 0
              type     = "NONE"
            }
          }
        }
        statement {
          regex_match_statement {
            regex_string = "^CyberStrikeAI/|^artex-agent|^artex-judge-"
            field_to_match {
              single_header {
                name = "user-agent"
              }
            }
            text_transformation {
              priority = 0
              type     = "NONE"
            }
          }
        }
      }
    }

    rule_label {
      name = "td:agentic:block:framework-user-agents"
    }

    visibility_config {
      sampled_requests_enabled   = true
      cloudwatch_metrics_enabled = true
      metric_name                = "td-framework-user-agents"
    }
  }

  rule {
    name     = "td-probe-markers"
    priority = 1

    action {
      dynamic "count" {
        for_each = var.block_tier_action == "count" ? [1] : []
        content {}
      }
      dynamic "block" {
        for_each = var.block_tier_action == "block" ? [1] : []
        content {}
      }
    }

    statement {
      or_statement {
        statement {
          regex_match_statement {
            regex_string = "zzz-nonexistent-xyz123|zzz_nonexistent_abc\\.txt|notexist-xyz|artex_write_probe|artx_persist_ok|artex_control_marker_zz9q|artex-probe-|code=aaaa&state=notvalidb64!!|hexstrikexsstest123|osprobe_"
            field_to_match {
              uri_path {}
            }
            text_transformation {
              priority = 0
              type     = "URL_DECODE"
            }
            text_transformation {
              priority = 1
              type     = "LOWERCASE"
            }
          }
        }
        statement {
          regex_match_statement {
            regex_string = "zzz-nonexistent-xyz123|zzz_nonexistent_abc\\.txt|notexist-xyz|artex_write_probe|artx_persist_ok|artex_control_marker_zz9q|artex-probe-|code=aaaa&state=notvalidb64!!|hexstrikexsstest123|osprobe_"
            field_to_match {
              query_string {}
            }
            text_transformation {
              priority = 0
              type     = "URL_DECODE"
            }
            text_transformation {
              priority = 1
              type     = "LOWERCASE"
            }
          }
        }
        statement {
          regex_match_statement {
            regex_string = "x-artx-key|x-artex-replay-nonce"
            field_to_match {
              headers {
                match_pattern {
                  all {}
                }
                match_scope = "KEY"
                oversize_handling = "CONTINUE"
              }
            }
            text_transformation {
              priority = 0
              type     = "LOWERCASE"
            }
          }
        }
      }
    }

    rule_label {
      name = "td:agentic:block:probe-markers"
    }

    visibility_config {
      sampled_requests_enabled   = true
      cloudwatch_metrics_enabled = true
      metric_name                = "td-probe-markers"
    }
  }

  rule {
    name     = "td-jwt-alg-none"
    priority = 2

    action {
      dynamic "count" {
        for_each = var.block_tier_action == "count" ? [1] : []
        content {}
      }
      dynamic "block" {
        for_each = var.block_tier_action == "block" ? [1] : []
        content {}
      }
    }

    statement {
      or_statement {
        statement {
          regex_match_statement {
            regex_string = "eyJhbGciOiJub25lI|eyJ0eXAiOiJKV1QiLCJhbGciOiJub25lI|eyJhbGciOiJOb25lI|eyJhbGciOiJOT05FI"
            field_to_match {
              uri_path {}
            }
            text_transformation {
              priority = 0
              type     = "URL_DECODE"
            }
          }
        }
        statement {
          regex_match_statement {
            regex_string = "eyJhbGciOiJub25lI|eyJ0eXAiOiJKV1QiLCJhbGciOiJub25lI|eyJhbGciOiJOb25lI|eyJhbGciOiJOT05FI"
            field_to_match {
              query_string {}
            }
            text_transformation {
              priority = 0
              type     = "URL_DECODE"
            }
          }
        }
        statement {
          regex_match_statement {
            regex_string = "eyJhbGciOiJub25lI|eyJ0eXAiOiJKV1QiLCJhbGciOiJub25lI|eyJhbGciOiJOb25lI|eyJhbGciOiJOT05FI"
            field_to_match {
              single_header {
                name = "authorization"
              }
            }
            text_transformation {
              priority = 0
              type     = "NONE"
            }
          }
        }
      }
    }

    rule_label {
      name = "td:agentic:block:jwt-alg-none"
    }

    visibility_config {
      sampled_requests_enabled   = true
      cloudwatch_metrics_enabled = true
      metric_name                = "td-jwt-alg-none"
    }
  }

  rule {
    name     = "td-webshell-probe-body"
    priority = 3

    action {
      dynamic "count" {
        for_each = var.block_tier_action == "count" ? [1] : []
        content {}
      }
      dynamic "block" {
        for_each = var.block_tier_action == "block" ? [1] : []
        content {}
      }
    }

    statement {
      regex_match_statement {
        regex_string = "OSPROBE_"
        field_to_match {
          body {
            oversize_handling = "CONTINUE"
          }
        }
        text_transformation {
          priority = 0
          type     = "NONE"
        }
      }
    }

    rule_label {
      name = "td:agentic:block:webshell-probe-body"
    }

    visibility_config {
      sampled_requests_enabled   = true
      cloudwatch_metrics_enabled = true
      metric_name                = "td-webshell-probe-body"
    }
  }

  rule {
    name     = "td-scanner-user-agents"
    priority = 4

    action {
      dynamic "count" {
        for_each = var.challenge_tier_action == "count" ? [1] : []
        content {}
      }
      dynamic "challenge" {
        for_each = var.challenge_tier_action == "challenge" ? [1] : []
        content {}
      }
      dynamic "captcha" {
        for_each = var.challenge_tier_action == "captcha" ? [1] : []
        content {}
      }
    }

    statement {
      regex_match_statement {
        regex_string = "fuzz faster u fool v2\\.1\\.0-dev|mozilla/5\\.0 \\(compatible exploit\\)|reconprobe/1\\.0|norma/0\\.4|azure-toolkit/1\\.0"
        field_to_match {
          single_header {
            name = "user-agent"
          }
        }
        text_transformation {
          priority = 0
          type     = "LOWERCASE"
        }
      }
    }

    rule_label {
      name = "td:agentic:challenge:scanner-user-agents"
    }

    visibility_config {
      sampled_requests_enabled   = true
      cloudwatch_metrics_enabled = true
      metric_name                = "td-scanner-user-agents"
    }
  }

  rule {
    name     = "td-reported-addresses"
    priority = 5

    action {
      dynamic "count" {
        for_each = var.challenge_tier_action == "count" ? [1] : []
        content {}
      }
      dynamic "challenge" {
        for_each = var.challenge_tier_action == "challenge" ? [1] : []
        content {}
      }
      dynamic "captcha" {
        for_each = var.challenge_tier_action == "captcha" ? [1] : []
        content {}
      }
    }

    statement {
      or_statement {
        statement {
          ip_set_reference_statement {
            arn = aws_wafv2_ip_set.td_ipv4.arn
          }
        }
        statement {
          ip_set_reference_statement {
            arn = aws_wafv2_ip_set.td_ipv6.arn
          }
        }
      }
    }

    rule_label {
      name = "td:agentic:challenge:reported-addresses"
    }

    visibility_config {
      sampled_requests_enabled   = true
      cloudwatch_metrics_enabled = true
      metric_name                = "td-reported-addresses"
    }
  }

  rule {
    name     = "td-ai-agent-readers"
    priority = 6

    action {
      count {}
    }

    statement {
      or_statement {
        statement {
          regex_match_statement {
            regex_string = "Claude-User \\(claude-code/"
            field_to_match {
              single_header {
                name = "user-agent"
              }
            }
            text_transformation {
              priority = 0
              type     = "NONE"
            }
          }
        }
        statement {
          regex_match_statement {
            regex_string = "^QwenCode/|^KimiCLI/|^opencode/|^agent-zero/"
            field_to_match {
              single_header {
                name = "user-agent"
              }
            }
