# Agentic attack detections by ThreatDefence. Generated by tools/build_waf.py from waf/signatures.yaml; do not edit.
# AWS provider 5.x. See waf/README.md.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

variable "scope" {
  description = "REGIONAL, or CLOUDFRONT (provider in us-east-1)"
  type        = string
  default     = "REGIONAL"
}

variable "block_tier_action" {
  description = "count or block, for the block-grade framework fingerprints"
  type        = string
  default     = "count"
}

variable "challenge_tier_action" {
  description = "count, challenge or captcha, for scanner user agents and reported addresses"
  type        = string
  default     = "count"
}

variable "opt_in_action" {
  description = "count or block, for opt-in rules (WSUS services from the internet)"
  type        = string
  default     = "count"
}

