  }

  rule {
    name     = "td-hermes-results-path"
    priority = 7

    action {
      count {}
    }

    statement {
      or_statement {
        statement {
          regex_match_statement {
            regex_string = "/hermes-results/"
            field_to_match {
              uri_path {}
            }
            text_transformation {
              priority = 0
              type     = "URL_DECODE"
