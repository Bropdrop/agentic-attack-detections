    action {
      dynamic "count" {
        for_each = var.opt_in_action == "count" ? [1] : []
        content {}
      }
      dynamic "block" {
        for_each = var.opt_in_action == "block" ? [1] : []
        content {}
      }
    }

    statement {
      or_statement {
        statement {
          regex_match_statement {
            regex_string = "/apiremoting30/webservice\\.asmx|/serversyncwebservice/serversyncwebservice\\.asmx|/reportingwebservice/reportingwebservice\\.asmx"
            field_to_match {
              uri_path {}
            }
            text_transformation {
              priority = 0
              type     = "URL_DECODE"
            }
            text_transformation {
              priority = 1
              type     = "LOWERCASE"
            }
          }
        }
        statement {
          regex_match_statement {
            regex_string = "/apiremoting30/webservice\\.asmx|/serversyncwebservice/serversyncwebservice\\.asmx|/reportingwebservice/reportingwebservice\\.asmx"
            field_to_match {
              query_string {}
            }
            text_transformation {
              priority = 0
