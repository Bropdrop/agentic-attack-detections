// Web probe artifacts: placeholder paths, alg none JWTs and the OAuth callback probe
// Agentic attack detections by ThreatDefence (ARTEX). https://threatdefence.com/article/artex-agentic-attack-framework-detection-hunting
// ES|QL hunt using ECS fields. Change the index pattern to match your data streams and baseline before alerting.
// The JWT prefixes are base64 of {"alg":"none" (alone or before typ), typ before alg, and the None and NONE spellings.
// Base64 is case-sensitive and LIKE matches case exactly, so do not lower-case the field or the prefixes.
FROM logs-*
| WHERE @timestamp > NOW() - 30 days AND url.original IS NOT NULL
| WHERE url.original LIKE "*zzz-nonexistent-xyz123*" OR url.original LIKE "*zzz_nonexistent_abc.txt*" OR url.original LIKE "*Notexist-xyz*"
    OR url.original LIKE "*eyJhbGciOiJub25lI*" OR url.original LIKE "*eyJ0eXAiOiJKV1QiLCJhbGciOiJub25lI*"
    OR url.original LIKE "*eyJhbGciOiJOb25lI*" OR url.original LIKE "*eyJhbGciOiJOT05FI*"
    OR url.original LIKE "*code=AAAA&state=notvalidb64!!*"
| STATS requests = COUNT(*), urls = VALUES(url.original), first_seen = MIN(@timestamp), last_seen = MAX(@timestamp)
    BY source.ip, user_agent.original
| SORT requests DESC
